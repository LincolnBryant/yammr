{% extends "layout.dtl" %}
{% block title %}Dashboard{% endblock %}
{% block content %}
<div class="page-header">
  <div>
    <h1>Dashboard</h1>
    <p>Mint a token, configure your client, and access curated models</p>
  </div>
</div>

  {# Token card (an htmx fragment) beside the usage summary. Grid cells stretch
     to equal height; the sibling-margin rule is suppressed inside grids. #}
<div class="grid grid-2">
  {# The token card is a fragment; its buttons re-render it in place. #}
  {% include "token_panel.dtl" %}

  {# Usage summary lives here once metering lands (see usage_panel.dtl).
     Until then an empty cell holds the grid shape so the token card keeps
     its half-width. #}
<div aria-hidden="true"></div>
</div>

<section id="connect" class="card">
  <div class="card-header">
    <h2><svg class="icon"><use href="#i-link"/></svg>Connect</h2>
    <span class="small muted">Base URL <code>{{ base_url }}</code></span>
  </div>
  {% include "connect.dtl" %}
</section>
{% endblock %}
